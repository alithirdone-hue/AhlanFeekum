                                        </TableHeader>
                                        <TableBody>
                                            @foreach (var userProfile in SelectedUserProfiles)
                                            {
                                                <TableRow>
                                                    <TableRowCell><Span class="float-start">@userProfile.DisplayName</Span></TableRowCell>
                                                    <TableRowCell>
                                                        <span class="btn btn-danger btn-sm float-end"
                                                              @onclick="() => SelectedUserProfiles.RemoveAll(s => s.Id == userProfile.Id)">
                                                            <Icon Class="fa fa-trash"></Icon>
                                                        </span>
                                                    </TableRowCell>
                                                </TableRow>
                                            }
                                        </TableBody>
                                    </Table>
                                }
</TabPanel>
<TabPanel Name="siteProperties-edit-tab">

                                <Row>
                                    <Column ColumnSize="ColumnSize.Is9">
                                        <Field>

                                            <Autocomplete 
                                                          Data="@SiteProperties"
                                                          TItem="LookupDto<Guid>"
                                                          TValue="string"
                                                          TextField="@((item) => item.DisplayName)"
                                                          ValueField="@((item) => item.Id.ToString())"
                                                          SearchChanged="@GetSitePropertyLookupAsync"
                                                          @bind-SelectedValue="@SelectedSitePropertyId"
                                                          @bind-SelectedText="@SelectedSitePropertyText"
                                                          Placeholder="&#8212;"/>
                                        </Field>
                                    </Column>

                                    <Column ColumnSize="ColumnSize.Is3">
                                        <Button Color="Color.Info" TextColor="TextColor.White" Size="Size.Medium" Clicked="AddSiteProperty">
                                            <Icon class="fa fa-plus"></Icon> @L["Add"]
                                        </Button>
                                    </Column>
                                </Row>
                                @if (SelectedSiteProperties.Any())
                                {
                                    <Table striped-rows="true" responsive-sm="true" class="mt-2">
                                        <TableHeader>
                                            <TableHeaderCell><Span class="float-start">@L["PropertyTitle"]</Span></TableHeaderCell>
                                        </TableHeader>
                                        <TableBody>
                                            @foreach (var siteProperty in SelectedSiteProperties)
                                            {
                                                <TableRow>
                                                    <TableRowCell><Span class="float-start">@siteProperty.DisplayName</Span></TableRowCell>
                                                    <TableRowCell>
                                                        <span class="btn btn-danger btn-sm float-end"
                                                              @onclick="() => SelectedSiteProperties.RemoveAll(s => s.Id == siteProperty.Id)">
                                                            <Icon Class="fa fa-trash"></Icon>
                                                        </span>
                                                    </TableRowCell>
                                                </TableRow>
                                            }
                                        </TableBody>
                                    </Table>
                                }
</TabPanel>

                </Validations>
                    </Content>
                </Tabs>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditUserNotificationModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="EditUserNotificationForm" Clicked="UpdateUserNotificationAsync" />
@*//<suite-custom-code-block-9>*@
@*//</suite-custom-code-block-9>*@
            </ModalFooter>
        </Form>
@*//<suite-custom-code-block-10>*@

                            {
                                <SelectItem TValue="Guid" Value="@(reservation.Id)">
                                    @(reservation.DisplayName)
                                </SelectItem>
                            }
                        </Select>
                    </Field>


                    
                    
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditCashPaymentModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="EditCashPaymentForm" Clicked="UpdateCashPaymentAsync" />
@*//<suite-custom-code-block-9>*@
@*//</suite-custom-code-block-9>*@
            </ModalFooter>
        </Form>
@*//<suite-custom-code-block-10>*@
@*//</suite-custom-code-block-10>*@
    </ModalContent>
</Modal>

